# Database
# Either set DATABASE_URL (postgres://, postgresql:// or sqlite:///./dev.db) ...
DATABASE_URL=
# ... or leave it empty and the URL is built from these:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=excel2whatsapp
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis / Celery (optional). Leave REDIS_URL empty to send from in-process
# background threads instead of a Celery worker.
REDIS_URL=redis://redis:6379/0
# Default to REDIS_URL when empty
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# App secrets
SECRET_KEY=replace-with-32-byte-minimum-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# WhatsApp Cloud API
ACCESS_TOKEN=YOUR_META_GRAPH_ACCESS_TOKEN
PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
VERIFY_TOKEN=your_verify_token
# Meta app secret: enables X-Hub-Signature-256 verification on POST /webhook/whatsapp
APP_SECRET=

# Uvicorn
HOST=0.0.0.0
PORT=8000

# Other
ENV=development
